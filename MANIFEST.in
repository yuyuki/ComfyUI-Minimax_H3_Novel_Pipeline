include LICENSE
include README.md
include AGENTS.md
include __init__.py
include requirements.txt
include .comfyignore

recursive-exclude * __pycache__
recursive-exclude * *.py[co]

recursive-include src/schema *.json
recursive-include web *.js
recursive-include examples *.md *.json
recursive-include docs *.md
recursive-include tools *.py
recursive-include tests/fixtures *.md
