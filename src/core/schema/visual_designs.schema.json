{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "minimax-h3-visual-designs.v1"
    },
    "image_style": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]*[^\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000](.|\\n)*$"
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "global_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]*[^\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000](.|\\n)*$"
          },
          "entity_type": {
            "enum": [
              "character",
              "location",
              "object"
            ]
          },
          "canonical_name": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]*[^\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000](.|\\n)*$"
          },
          "source_facts": {
            "type": "object",
            "properties": {
              "stable_visual_description": {
                "type": "string"
              },
              "distinguishing_features": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "stable_visual_description",
              "distinguishing_features"
            ],
            "additionalProperties": false
          },
          "added_details": {
            "type": "object"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "identity_status": {
            "enum": [
              "confirmed",
              "ambiguous"
            ]
          },
          "character_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "global_id",
          "entity_type",
          "canonical_name",
          "source_facts",
          "added_details"
        ],
        "additionalProperties": false,
        "dependentRequired": {
          "character_id": ["identity_status"],
          "identity_status": ["character_id"]
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "entity_type": {
                  "const": "character"
                }
              }
            },
            "then": {
              "properties": {
                "added_details": {
                  "type": "object",
                  "properties": {
                    "age_appearance": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]*[^\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000](.|\\n)*$"
                    },
                    "skin": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]*[^\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000](.|\\n)*$"
                    },
                    "facial_features": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]*[^\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000](.|\\n)*$"
                    },
                    "hair": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]*[^\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000](.|\\n)*$"
                    },
                    "eyes": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]*[^\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000](.|\\n)*$"
                    },
                    "build": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]*[^\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000](.|\\n)*$"
                    },
                    "default_outfit": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]*[^\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000](.|\\n)*$"
                    },
                    "footwear": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]*[^\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000](.|\\n)*$"
                    },
                    "accessories": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]*[^\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000](.|\\n)*$"
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "entity_type": {
                  "const": "location"
                }
              }
            },
            "then": {
              "properties": {
                "added_details": {
                  "type": "object",
                  "properties": {
                    "materials": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]*[^\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000](.|\\n)*$"
                    },
                    "colors": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]*[^\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000](.|\\n)*$"
                    },
                    "architecture": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]*[^\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000](.|\\n)*$"
                    },
                    "layout": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]*[^\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000](.|\\n)*$"
                    },
                    "fixtures": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]*[^\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000](.|\\n)*$"
                    },
                    "vegetation": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]*[^\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000](.|\\n)*$"
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "entity_type": {
                  "const": "object"
                }
              }
            },
            "then": {
              "properties": {
                "added_details": {
                  "type": "object",
                  "properties": {
                    "shape": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]*[^\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000](.|\\n)*$"
                    },
                    "materials": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]*[^\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000](.|\\n)*$"
                    },
                    "colors": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]*[^\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000](.|\\n)*$"
                    },
                    "dimensions": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]*[^\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000](.|\\n)*$"
                    },
                    "construction": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]*[^\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000](.|\\n)*$"
                    },
                    "markings": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]*[^\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000](.|\\n)*$"
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                }
              }
            }
          }
        ]
      }
    },
    "character_profiles": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Editable source-grounded character profiles",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "$schema",
        "format_version",
        "source_digest",
        "source_document",
        "profiles",
        "excluded_evidence"
      ],
      "properties": {
        "$schema": {
          "type": "string"
        },
        "format_version": {
          "type": "integer",
          "const": 2
        },
        "source_digest": {
          "type": "string",
          "minLength": 1
        },
        "source_document": {
          "type": "object"
        },
        "profiles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "local_id",
              "link_to_local_id",
              "canonical_name",
              "aliases",
              "identity_status",
              "identity_support",
              "attributes",
              "supporting_evidence",
              "global_traits",
              "temporary_states",
              "unresolved_conflicts",
              "chronological_changes",
              "trait_relations"
            ],
            "properties": {
              "local_id": {
                "type": "string",
                "minLength": 1
              },
              "link_to_local_id": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "canonical_name": {
                "type": "string",
                "minLength": 1
              },
              "aliases": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "identity_status": {
                "type": "string",
                "enum": [
                  "confirmed",
                  "ambiguous"
                ]
              },
              "identity_support": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "attributes": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "stable_physical",
                  "temporary_appearance",
                  "other_information",
                  "inferred_information"
                ],
                "properties": {
                  "stable_physical": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "attribute",
                        "value",
                        "classification",
                        "persistence",
                        "evidence_id"
                      ],
                      "properties": {
                        "attribute": {
                          "type": "string",
                          "minLength": 1
                        },
                        "value": {
                          "type": "string",
                          "minLength": 1
                        },
                        "classification": {
                          "type": "string",
                          "minLength": 1
                        },
                        "persistence": {
                          "type": "string",
                          "minLength": 1
                        },
                        "evidence_id": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  },
                  "temporary_appearance": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "attribute",
                        "value",
                        "classification",
                        "persistence",
                        "evidence_id"
                      ],
                      "properties": {
                        "attribute": {
                          "type": "string",
                          "minLength": 1
                        },
                        "value": {
                          "type": "string",
                          "minLength": 1
                        },
                        "classification": {
                          "type": "string",
                          "minLength": 1
                        },
                        "persistence": {
                          "type": "string",
                          "minLength": 1
                        },
                        "evidence_id": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  },
                  "other_information": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "attribute",
                        "value",
                        "classification",
                        "persistence",
                        "evidence_id"
                      ],
                      "properties": {
                        "attribute": {
                          "type": "string",
                          "minLength": 1
                        },
                        "value": {
                          "type": "string",
                          "minLength": 1
                        },
                        "classification": {
                          "type": "string",
                          "minLength": 1
                        },
                        "persistence": {
                          "type": "string",
                          "minLength": 1
                        },
                        "evidence_id": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  },
                  "inferred_information": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "attribute",
                        "value",
                        "classification",
                        "persistence",
                        "evidence_id"
                      ],
                      "properties": {
                        "attribute": {
                          "type": "string",
                          "minLength": 1
                        },
                        "value": {
                          "type": "string",
                          "minLength": 1
                        },
                        "classification": {
                          "type": "string",
                          "minLength": 1
                        },
                        "persistence": {
                          "type": "string",
                          "minLength": 1
                        },
                        "evidence_id": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  }
                }
              },
              "supporting_evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "evidence_id",
                    "observation"
                  ],
                  "properties": {
                    "evidence_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "observation": {
                      "type": "object"
                    }
                  }
                },
                "minItems": 1
              },
              "global_traits": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "trait",
                    "value",
                    "evidence_ids"
                  ],
                  "properties": {
                    "trait": {
                      "type": "string",
                      "minLength": 1
                    },
                    "value": {
                      "type": "string",
                      "minLength": 1
                    },
                    "evidence_ids": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 1,
                      "uniqueItems": true
                    }
                  }
                }
              },
              "temporary_states": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "trait",
                    "value",
                    "evidence_ids"
                  ],
                  "properties": {
                    "trait": {
                      "type": "string",
                      "minLength": 1
                    },
                    "value": {
                      "type": "string",
                      "minLength": 1
                    },
                    "evidence_ids": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 1,
                      "uniqueItems": true
                    }
                  }
                }
              },
              "unresolved_conflicts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "conflict_id",
                    "trait",
                    "scope",
                    "evidence_ids",
                    "choices"
                  ],
                  "properties": {
                    "conflict_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "trait": {
                      "type": "string",
                      "minLength": 1
                    },
                    "scope": {
                      "type": "string",
                      "minLength": 1
                    },
                    "evidence_ids": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 1,
                      "uniqueItems": true
                    },
                    "choices": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "id",
                          "value",
                          "evidence_ids",
                          "selected"
                        ],
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "value": {
                            "type": "string",
                            "minLength": 1
                          },
                          "evidence_ids": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1
                            },
                            "minItems": 1,
                            "uniqueItems": true
                          },
                          "selected": {
                            "type": "boolean"
                          }
                        }
                      },
                      "minItems": 2
                    }
                  }
                }
              },
              "chronological_changes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "trait",
                    "before_id",
                    "after_id",
                    "support_id",
                    "temporal_quote"
                  ],
                  "properties": {
                    "trait": {
                      "type": "string",
                      "minLength": 1
                    },
                    "before_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "after_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "support_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "temporal_quote": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "trait_relations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "trait",
                    "relation",
                    "scope",
                    "evidence",
                    "before_id",
                    "after_id",
                    "support_id",
                    "temporal_quote"
                  ],
                  "properties": {
                    "trait": {
                      "type": "string",
                      "minLength": 1
                    },
                    "relation": {
                      "type": "string",
                      "enum": [
                        "equivalent",
                        "conflict",
                        "change",
                        "independent",
                        "uncertain"
                      ]
