{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MiniMax H3 Novel chapter references",
  "type": "object",
  "properties": {
    "schema_version": {"const": "minimax-h3-novel-refs.chapter.v4"},
    "timeline_version": {"const": "cinematic-reference-timeline.v1"},
    "cache_key": {"type": "string", "minLength": 1},
    "chapter_id": {"type": "string", "minLength": 1},
    "chapter_name": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "properties": {
        "file": {"type": "string"},
        "sha256": {"type": "string", "minLength": 1}
      },
      "required": ["file", "sha256"],
      "additionalProperties": false
    },
    "sequences": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "narrative_review": {
      "type": "object",
      "properties": {
        "issues": {"type": "array", "items": {"type": "object"}},
        "extraction_issues": {"type": "array", "items": {"type": "object"}}
      },
      "required": ["issues"],
      "additionalProperties": false
    },
    "characters": {"type": "array", "items": {"$ref": "#/$defs/character"}},
    "locations": {"type": "array", "items": {"$ref": "#/$defs/location"}},
    "objects": {"type": "array", "items": {"$ref": "#/$defs/object"}}
  },
  "required": ["schema_version", "timeline_version", "cache_key", "chapter_id", "chapter_name", "source", "sequences", "characters", "locations", "objects"],
  "additionalProperties": false,
  "$defs": {
    "entity": {
      "type": "object",
      "properties": {
        "local_id": {"type": "string", "minLength": 1},
        "link_to_local_id": {"type": ["string", "null"], "default": null},
        "canonical_name": {"type": "string", "minLength": 1},
        "aliases": {"type": "array", "items": {"type": "string"}},
        "stable_visual_description": {"type": "string"},
        "distinguishing_features": {"type": "array", "items": {"type": "string"}},
        "importance": {"enum": ["major", "recurring", "minor", "background"]},
        "reference_priority": {"enum": ["required", "recommended", "optional"]},
        "reference_view_hints": {"type": "array", "items": {"type": "string"}},
        "evidence": {"type": "array", "items": {"type": "string"}},
        "first_sequence": {"type": "integer", "minimum": 1},
        "first_phase": {"enum": ["initialState", "event", "endingState"]},
        "state_by_sequence": {"type": "object", "minProperties": 1}
      },
      "required": ["local_id", "link_to_local_id", "canonical_name", "aliases", "first_sequence", "first_phase", "state_by_sequence"]
    },
    "character": {
      "allOf": [
        {"$ref": "#/$defs/entity"},
        {
          "properties": {
            "chapter_appearance": {"type": "string"},
            "voice_description": {"type": "string"},
            "speaks": {"type": "boolean"}
          },
          "required": ["chapter_appearance", "voice_description", "speaks"]
        }
      ]
    },
    "location": {
      "allOf": [
        {"$ref": "#/$defs/entity"},
        {
          "properties": {"chapter_state": {"type": "string"}},
          "required": ["chapter_state"]
        }
      ]
    },
    "object": {
      "allOf": [
        {"$ref": "#/$defs/entity"},
        {
          "properties": {"chapter_state": {"type": "string"}},
          "required": ["chapter_state"]
        }
      ]
    }
  }
}
