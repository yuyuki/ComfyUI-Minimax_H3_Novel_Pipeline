{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "minimax-h3-reference-links.v1"
    },
    "source_digest": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "chapter_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "local_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "canonical_name": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "entity_type": {
            "enum": [
              "character",
              "location",
              "object"
            ]
          },
          "classification": {
            "enum": [
              "entity",
              "manifestation"
            ]
          }
        },
        "required": [
          "chapter_id",
          "local_id",
          "canonical_name",
          "entity_type",
          "classification"
        ],
        "additionalProperties": false
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "identity",
              "attribution",
              "relation"
            ]
          },
          "source": {
            "type": "object",
            "properties": {
              "chapter_id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "local_id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "required": [
              "chapter_id",
              "local_id"
            ],
            "additionalProperties": false
          },
          "target": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "chapter_id": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "local_id": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  }
                },
                "required": [
                  "chapter_id",
                  "local_id"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "sequence": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "phase": {
            "enum": [
              null,
              "initialState",
              "event",
              "endingState"
            ]
          },
          "relation": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "status": {
            "enum": [
              "proposed",
              "confirmed",
              "rejected",
              "unresolved"
            ]
          },
          "reason": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        "required": [
          "kind",
          "source",
          "target",
          "sequence",
          "phase",
          "relation",
          "status",
          "reason",
          "evidence"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "identity"
                }
              }
            },
            "then": {
              "properties": {
                "target": {
                  "type": "object",
                  "properties": {
                    "chapter_id": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "local_id": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    }
                  },
                  "required": [
                    "chapter_id",
                    "local_id"
                  ],
                  "additionalProperties": false
                },
                "relation": {
                  "const": "same_as"
                },
                "sequence": {
                  "type": "null"
                },
                "phase": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "attribution"
                }
              }
            },
            "then": {
              "properties": {
                "sequence": {
                  "type": "integer",
                  "minimum": 1
                },
                "phase": {
                  "enum": [
                    "initialState",
                    "event",
                    "endingState"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "relation"
                }
              }
            },
            "then": {
              "properties": {
                "target": {
                  "type": "object",
                  "properties": {
                    "chapter_id": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "local_id": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    }
                  },
                  "required": [
                    "chapter_id",
                    "local_id"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "confirmed"
                }
              }
            },
            "then": {
              "properties": {
                "target": {
                  "type": "object",
                  "properties": {
                    "chapter_id": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "local_id": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    }
                  },
                  "required": [
                    "chapter_id",
                    "local_id"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "source_digest",
    "entities",
    "links"
  ],
  "additionalProperties": false
}
